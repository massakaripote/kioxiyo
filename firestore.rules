rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 管理者判定関数: adminsコレクションにUIDが存在するか、またはカスタムクレームがあるか
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 認証済み判定
    function isAuthenticated() {
      return request.auth != null;
    }

    // 所有者判定
    function isOwner(authorUid) {
      return isAuthenticated() && request.auth.uid == authorUid;
    }

    // 1. 一般公開問題集 (publicProblemSets)
    match /publicProblemSets/{setId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.isPublic == true;
      allow update, delete: if isOwner(resource.data.authorUid) || isAdmin();
    }

    // 2. URL限定公開問題集 (unlistedProblemSets)
    // ※ 通常の一覧取得(list)は不許可とし、IDを知っている個別取得(get)のみ許可
    match /unlistedProblemSets/{setId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAuthenticated()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.isPublic == false;
      allow update, delete: if isOwner(resource.data.authorUid) || isAdmin();
    }

    // 3. 地理の時事問題 (currentAffairs)
    match /currentAffairs/{postId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isOwner(resource.data.authorUid) || isAdmin();
    }

    // 4. 通報データ (reports)
    // 一般ユーザーは作成のみ可能。閲覧・変更は管理者のみ
    match /reports/{reportId} {
      allow create: if isAuthenticated()
        && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // 5. ユーザー表示名プロフィール (userProfiles)
    match /userProfiles/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // 6. 管理者リスト (admins)
    // クライアントからの勝手な作成・編集は一切禁止
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}

